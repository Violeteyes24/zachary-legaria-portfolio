# Resend API key for the contact form Server Action.
# Get one at https://resend.com (free tier: 3,000 emails/month).
#
# Without a verified domain, Resend only delivers from onboarding@resend.dev
# to the account owner address, which is exactly what this form needs.
# Server-side only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=your_resend_api_key_here
